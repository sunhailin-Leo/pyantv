#!/usr/bin/env bash
# ============================================================
# pyantv — Harness Configuration
# ============================================================

# ── Python & Build ──────────────────────────────────────────
PYTHON_MIN_VERSION="3.6"
BUILD_CMD="python setup.py sdist bdist_wheel"
TEST_CMD="pytest -v --cov-config=.coveragerc --cov=./ test/"
LINT_CMD="flake8 --exclude=build,example,.venv --max-line-length=89 --ignore=F401"

# ── Scoring ─────────────────────────────────────────────────
SCORE_TOTAL=100
SCORE_BUILD=20
SCORE_FUNCTION=30
SCORE_TEST=20
SCORE_ARCH=20
SCORE_QUALITY=10
SCORE_PASS_THRESHOLD=90

# ── Test Thresholds ─────────────────────────────────────────
INCREMENTAL_COVERAGE_MIN=70
MAX_FILE_LINES=500
MAX_FUNCTION_LINES=50

# ── Iteration ───────────────────────────────────────────────
MAX_ITERATE_ROUNDS=3
PREFLIGHT_TIMEOUT=30
EVALUATE_TIMEOUT=300

# ── Paths ───────────────────────────────────────────────────
SRC_DIR="pyantv"
TEST_DIR="test"
SPRINT_DIR=".harness/sprints"
SCRIPT_DIR=".harness/scripts"
ARTIFACT_DIR=".harness/artifacts"
