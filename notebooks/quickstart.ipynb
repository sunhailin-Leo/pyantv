   "source": [
    "#%% raw\n",
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# pyantv Quick Start\\n\",\n",
    "    \"\\n\",\n",
    "    \"Welcome to pyantv! This notebook will help you get started with creating beautiful charts using Python and AntV.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"!pip install pyantv\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"from pyantv import Line, options as opts\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Line Chart Example\\n\",\n",
    "    \"line = (\\n\",\n",
    "    \"    Line()\\n\",\n",
    "    \"    .add_xaxis([\\\"Mon\\\", \\\"Tue\\\", \\\"Wed\\\", \\\"Thu\\\", \\\"Fri\\\", \\\"Sat\\\", \\\"Sun\\\"])\\n\",\n",
    "    \"    .add_yaxis(\\\"Series A\\\", [150, 230, 224, 218, 135, 147, 260])\\n\",\n",
    "    \"    .add_yaxis(\\\"Series B\\\", [320, 332, 301, 334, 390, 330, 320])\\n\",\n",
    "    \"    .set_global_opts(\\n\",\n",
    "    \"        title_opts=opts.TitleOpts(title=\\\"Line Chart Example\\\"),\\n\",\n",
    "    \"        xaxis_opts=opts.AxisOpts(axislabel_opts=opts.LabelOpts(rotate=-15)),\\n\",\n",
    "    \"    )\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"line.render_notebook()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Bar Chart Example\\n\",\n",
    "    \"from pyantv import Bar\\n\",\n",
    "    \"\\n\",\n",
    "    \"bar = (\\n\",\n",
    "    \"    Bar()\\n\",\n",
    "    \"    .add_xaxis([\\\"Product A\\\", \\\"Product B\\\", \\\"Product C\\\", \\\"Product D\\\", \\\"Product E\\\"])\\n\",\n",
    "    \"    .add_yaxis(\\\"Sales\\\", [20, 40, 15, 80, 70])\\n\",\n",
    "    \"    .set_global_opts(\\n\",\n",
    "    \"        title_opts=opts.TitleOpts(title=\\\"Bar Chart Example\\\"),\\n\",\n",
    "    \"        yaxis_opts=opts.AxisOpts(axislabel_opts=opts.LabelOpts(formatter=\\\"{value} units\\\")),\\n\",\n",
    "    \"    )\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"bar.render_notebook()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Pie Chart Example using Interval with Polar Coordinates\\n\",\n",
    "    \"from pyantv import Interval\\n\",\n",
    "    \"\\n\",\n",
    "    \"pie = (\\n\",\n",
    "    \"    Interval()\\n\",\n",
    "    \"    .add_data(\\n\",\n",
    "    \"        [\\n\",\n",
    "    \"            [\\\"Category A\\\", 40],\\n\",\n",
    "    \"            [\\\"Category B\\\", 30],\\n\",\n",
    "    \"            [\\\"Category C\\\", 20],\\n\",\n",
    "    \"            [\\\"Category D\\\", 10],\\n\",\n",
    "    \"        ]\\n\",\n",
    "    \"    )\\n\",\n",
    "    \"    .set_global_opts(\\n\",\n",
    "    \"        title_opts=opts.TitleOpts(title=\\\"Pie Chart Example\\\"),\\n\",\n",
    "    \"        coord_opts=opts.CoordOpts(type=\\\"polar\\\"),\\n\",\n",
    "    \"    )\\n\",\n",
    "    \")\\n\",\n",
    "    \"\\n\",\n",
    "    \"pie.render_notebook()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## More Examples\\n\",\n",
    "    \"\\n\",\n",
    "    \"Explore more chart examples in the [pyantv GitHub repository](https://github.com/sunhailin-Leo/pyantv/tree/main/example).\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
